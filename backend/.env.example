# Canon Backend Environment Configuration (.env.example)
# Copy to .env and configure local/staging values. NEVER commit real secrets to git.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Database (Supabase in cloud, local postgres in docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/canon
# DIRECT_URL is required for Alembic migrations if using PgBouncer pooler on Supabase
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/canon

# Security & Authentication (JWT + Argon2)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-secure-random-256-bit-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# LLM Provider Configuration
# Supported providers: mock, mistral, groq, openai
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=mock-model

# CORS & Proxy Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://canon-web.vercel.app"]

# Upload & Rate Limits
MAX_UPLOAD_SIZE_BYTES=15728640
