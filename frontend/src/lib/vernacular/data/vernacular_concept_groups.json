  "safe_blockers": [
    {
      "phrase": "RBI registered NBFC",
      "note": "Identifies a non-banking financial institution registered under RBI oversight",
      "effect": "downgrade_to_review"
    },
    {
      "phrase": "subject to credit assessment",
      "note": "Indicates statutory creditworthiness evaluation by a regulated underwriter",
      "effect": "downgrade_to_review"
    },
    {
      "phrase": "KYC required",
      "note": "Explicitly mandates Know Your Customer documentation and identity verification",
      "effect": "downgrade_to_review"
    },
    {
      "phrase": "T&Cs apply",
      "note": "Standard commercial qualifier signaling formal contractual terms and conditions",
      "effect": "downgrade_to_review"
    },
    {
      "phrase": "terms & conditions apply",
      "note": "Comprehensive formal terms declaration ensuring transparent customer disclosure",
      "effect": "downgrade_to_review"
